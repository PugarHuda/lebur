# Copy to packages/contracts/.env — the Hardhat config loads the .env next to it.

# ── Ethereum Sepolia ─────────────────────────────────────────────────────────
# rpc.sepolia.org is dead, publicnode rejects eth_getLogs without a token, and
# 1rpc.io caps at 50 blocks. drpc works.
SEPOLIA_RPC_URL=https://sepolia.drpc.org
DEPLOYER_PRIVATE_KEY=

# ── Nox (Ethereum Sepolia) — verified live 2026-07-22 ────────────────────────
NOX_COMPUTE=0x24Ef36Ec5b626D7DCD09a98F3083c2758F0F77bF
NOX_GATEWAY=https://gateway-testnets.noxprotocol.dev

# ── Curve StableSwap-NG (Ethereum Sepolia) ───────────────────────────────────
# Undocumented by Curve but live; factory codehash is byte-identical to mainnet.
# Re-verify any time with: node --experimental-strip-types scripts/verify-curve.ts
CURVE_FACTORY=0xfb37b8D939FFa77114005e61CFc2e543d6F49A81

# ── filled in by scripts/deploy-pool.ts ──────────────────────────────────────
TOKEN0=
TOKEN1=
CURVE_POOL=
POOL_I0=0
POOL_I1=1

# ── filled in by scripts/deploy-sepolia.ts ───────────────────────────────────
BATCH_ADDRESS=
CTOKEN0=
CTOKEN1=

# ── per-run knobs ────────────────────────────────────────────────────────────
# deploy-pool.ts is a DRY RUN unless BROADCAST=1. It is the only script that can
# deploy a Curve pool, so it is the only one that needs an explicit opt-in.
# BROADCAST=1
# SEED=100000                  # liquidity per side, whole tokens
# SUBMIT_WINDOW_SECS=1800      # how long the book stays open. Set this deliberately.
# SIDE=bid                     # submit-order.ts: bid | ask
# AMOUNT=1000                  # whole tokens
# TICK=2                       # index into the public price ladder
# VERIFY=1                     # poll-decrypt your own recorded escrow after submitting
# TRADER_PRIVATE_KEY=          # defaults to DEPLOYER_PRIVATE_KEY
